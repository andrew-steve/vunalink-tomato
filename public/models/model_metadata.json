{
  "name": "VunaLink MobileNetV2",
  "version": "0.3.0",
  "format": "saved_model",
  "dataset": "PlantVillage",
  "class_count": 11,
  "input": {
    "width": 224,
    "height": 224,
    "channels": 3,
    "dtype": "float32",
    "color_format": "RGB",
    "tensor_layout": "NHWC"
  },
  "preprocessing": {
    "resize": "image_dataset_from_directory target size",
    "scaling": "mobilenet_v2.preprocess_input",
    "formula": "(pixel / 127.5) - 1",
    "channel_order": "RGB",
    "applied_in_model": true
  },
  "output": {
    "shape": [
      null,
      11
    ],
    "dtype": "float32",
    "semantics": "softmax class probabilities"
  },
  "class_mapping": "class_mapping.json",
  "classes": [
    "Not_tomato",
    "Tomato___Bacterial_spot",
    "Tomato___Early_blight",
    "Tomato___Late_blight",
    "Tomato___Leaf_Mold",
    "Tomato___Septoria_leaf_spot",
    "Tomato___Spider_mites Two-spotted_spider_mite",
    "Tomato___Target_Spot",
    "Tomato___Tomato_Yellow_Leaf_Curl_Virus",
    "Tomato___Tomato_mosaic_virus",
    "Tomato___healthy"
  ],
  "training": {
    "input_width": 224,
    "input_height": 224,
    "batch_size": 32,
    "epochs": 20,
    "fine_tune_epochs": 5,
    "learning_rate": 0.001
  },
  "best_checkpoint": "best_model.keras"
}
